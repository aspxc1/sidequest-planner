  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The main action for creating or advancing work; compact, sentence case, with an authored stroke icon.",
      "html": "<button class=\"ds-primary\" type=\"button\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>Add task</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:36px;border:1px solid;border-radius:6px;padding:7px 12px;font-family:'Segoe UI',system-ui,-apple-system,sans-serif;font-weight:550;font-size:12px;line-height:1.5;white-space:nowrap;cursor:pointer;background:var(--green,#236b54);border-color:var(--green,#236b54);color:var(--white,#fff)}.ds-primary svg{width:18px;height:18px;flex-shrink:0}.ds-primary:hover{background:#19563f}.ds-primary:focus-visible{outline:3px solid var(--focus,#458a6c);outline-offset:3px;}.ds-primary:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A supporting action such as editing the project brief; white fill and a fine border keep it quieter than the main action.",
      "html": "<button class=\"ds-secondary\" type=\"button\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14 5l5 5M4 20l5-1L21 7l-5-5L4 14z\"/></svg>Edit brief</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:36px;border:1px solid;border-radius:6px;padding:7px 12px;font-family:'Segoe UI',system-ui,-apple-system,sans-serif;font-weight:550;font-size:12px;line-height:1.5;white-space:nowrap;cursor:pointer;background:var(--white,#fff);color:var(--ink,#202e2b);border-color:#d7dfd7}.ds-secondary svg{width:18px;height:18px;flex-shrink:0}.ds-secondary:hover{background:#f0f4ee;border-color:#b7c8ba}.ds-secondary:focus-visible{outline:3px solid var(--focus,#458a6c);outline-offset:3px;}.ds-secondary:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Labeled Text Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "The standard editor field, with a visible sentence-case label, native input, and shared keyboard outline.",
      "html": "<div class=\"ds-field\"><label for=\"ds-task-title\">Task title</label><input id=\"ds-task-title\" name=\"title\" type=\"text\" value=\"Add incident grouping rules\" placeholder=\"What needs to happen?\"></div>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:7px;width:min(100%,360px);font-family:'Segoe UI',system-ui,-apple-system,sans-serif;color:var(--ink,#202e2b)}.ds-field label{font-size:12px;font-weight:600;line-height:1.5}.ds-field input{width:100%;border:1px solid #cfd9cc;background:var(--white,#fff);border-radius:6px;padding:10px 11px;font-family:'Segoe UI',system-ui,-apple-system,sans-serif;font-size:13px;color:var(--ink,#202e2b);caret-color:var(--green,#236b54);outline-offset:3px}.ds-field input::placeholder{color:#66735f}.ds-field input:focus-visible{outline:3px solid var(--focus,#458a6c);outline-offset:3px;}"
    },
    {
      "name": "Forest Navigation",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "The rail pattern pairs recognizable stroke icons with clear section labels; the active item has a pale leaf fill and stronger weight.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Project\"><div class=\"ds-nav-label\">PROJECT</div><button type=\"button\" class=\"ds-nav-item ds-nav-active\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z\"/></svg><span>Overview</span></button><button type=\"button\" class=\"ds-nav-item\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 4v16M5 6h13l-3 4 3 4H5\"/></svg><span>Roadmap</span></button><button type=\"button\" class=\"ds-nav-item\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 4h18v16H3zM9 4v16M15 4v16M5 8h2M11 8h2M17 8h2M5 12h2M11 12h2\"/></svg><span>Task board</span><span class=\"ds-nav-count\">18</span></button></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:3px;width:202px;background:var(--forest,#172d29);padding:18px;font-family:'Segoe UI',system-ui,-apple-system,sans-serif}.ds-nav-label{margin:0 12px 9px;font-size:10px;font-weight:600;letter-spacing:.13em;color:#9aafa3;line-height:1.5}.ds-nav-item{border:0;background:none;color:#bbcec3;display:flex;align-items:center;gap:11px;padding:10px 13px;text-align:left;border-radius:6px;min-height:39px;font-family:'Segoe UI',system-ui,-apple-system,sans-serif;font-size:14px;line-height:1.5;cursor:pointer}.ds-nav-item svg{width:18px;height:18px;flex-shrink:0}.ds-nav-item:hover{background:#263f37;color:#fff}.ds-nav-item.ds-nav-active{background:#dfede2;color:#1f4836;font-weight:650}.ds-nav-item:focus-visible{outline:3px solid var(--focus,#458a6c);outline-offset:3px;}.ds-nav-count{margin-left:auto;font-size:11px;min-width:20px;text-align:center;opacity:.8}"
    },
    {
      "name": "Implementation Kind Chips",
      "kind": "chip",
      "refersTo": "chip-software",
      "description": "Static text labels distinguish deterministic software, GPT/API work, and mixed tasks. They convey category without implying an action.",
      "html": "<div class=\"ds-chips\"><span class=\"ds-chip ds-chip-software\">Software</span><span class=\"ds-chip ds-chip-gpt\">GPT / API</span><span class=\"ds-chip ds-chip-mixed\">Mixed</span></div>",
      "css": ".ds-chips{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-family:'Segoe UI',system-ui,-apple-system,sans-serif}.ds-chip{display:inline-flex;align-items:center;gap:5px;font-size:10px;font-weight:600;border-radius:4px;padding:3px 7px;line-height:1.3;white-space:nowrap}.ds-chip-software{color:var(--software,#446873);background:#edf2f4}.ds-chip-gpt{color:var(--gpt,#80563c);background:#f5eae2}.ds-chip-mixed{color:#705d84;background:#f0ecf5}"
    },
    {
      "name": "Task Card",
      "kind": "card",
      "refersTo": "task-card",
      "description": "A flat work card with an editable task title, explicit implementation kind, priority, milestone, and a native alternate move control.",
      "html": "<article class=\"ds-task-card\" draggable=\"true\"><button type=\"button\" class=\"ds-task-title\">Add model timeout and fallback</button><div class=\"ds-task-meta\"><span class=\"ds-task-kind\">Mixed</span><span class=\"ds-task-priority\">high priority</span></div><div class=\"ds-task-milestone\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 4v16M5 6h13l-3 4 3 4H5\"/></svg>Grounded AI summaries</div><select class=\"ds-task-status\" aria-label=\"Status for Add model timeout and fallback\"><option>Backlog</option><option>To do</option><option>In progress</option><option>Done</option></select></article>",
      "css": ".ds-task-card{width:244px;background:var(--white,#fff);color:var(--ink,#202e2b);border:1px solid #dee5da;border-radius:8px;padding:14px;font-family:'Segoe UI',system-ui,-apple-system,sans-serif;cursor:grab}.ds-task-card:hover{border-color:#9eb9a3}.ds-task-card.ds-dragging{opacity:.5}.ds-task-title{border:0;background:transparent;color:inherit;text-align:left;font-family:'Segoe UI',system-ui,-apple-system,sans-serif;font-weight:550;font-size:12px;line-height:1.6;padding:0;display:block;width:100%;overflow-wrap:anywhere;cursor:pointer}.ds-task-title:hover{color:var(--green,#236b54)}.ds-task-title:focus-visible,.ds-task-status:focus-visible{outline:3px solid var(--focus,#458a6c);outline-offset:3px;}.ds-task-meta{display:flex;align-items:center;justify-content:space-between;gap:5px;margin-top:11px}.ds-task-kind{font-size:10px;font-weight:600;border-radius:4px;padding:3px 7px;line-height:1.3;color:#705d84;background:#f0ecf5}.ds-task-priority{font-size:10px;font-weight:600;color:#a15c45;line-height:1.3}.ds-task-milestone{color:var(--muted,#62716b);font-size:10px;margin-top:12px;display:flex;align-items:center;gap:5px;line-height:1.5}.ds-task-milestone svg{width:12px;height:12px;flex-shrink:0}.ds-task-status{border:0;background:#f6f8f3;color:#52665a;border-radius:4px;font-family:'Segoe UI',system-ui,-apple-system,sans-serif;font-size:10px;padding:4px;width:100%;margin-top:11px;cursor:pointer}"
    },
    {
      "name": "Milestone Track",
      "kind": "custom",
      "refersTo": "milestone-current",
      "description": "The signature notebook pattern joins completed and current deliverables, with task counts, due dates, compact progress, and an explicit next action.",
      "html": "<section class=\"ds-milestone-panel\" aria-label=\"Project roadmap\"><h2 class=\"ds-milestone-heading\">Project roadmap</h2><div class=\"ds-milestones\"><div class=\"ds-milestone-row\"><div class=\"ds-milestone-node ds-milestone-complete\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12l4 4L19 6\"/></svg></div><div class=\"ds-milestone-info\"><h3>Foundation &amp; contracts</h3><p>4/4 tasks · Complete</p></div><div class=\"ds-milestone-tail\">Nov 15<div class=\"ds-progress\" role=\"progressbar\" aria-label=\"Foundation and contracts\" aria-valuenow=\"100\" aria-valuemin=\"0\" aria-valuemax=\"100\"><div class=\"ds-fill ds-fill-complete\"></div></div></div></div><div class=\"ds-milestone-row\"><div class=\"ds-milestone-node ds-milestone-current\">2</div><div class=\"ds-milestone-info\"><h3>Ingestion &amp; incident engine</h3><p>2/5 tasks · In progress</p></div><div class=\"ds-milestone-tail\">Nov 22<div class=\"ds-progress\" role=\"progressbar\" aria-label=\"Ingestion and incident engine\" aria-valuenow=\"40\" aria-valuemin=\"0\" aria-valuemax=\"100\"><div class=\"ds-fill ds-fill-current\"></div></div></div></div></div><div class=\"ds-next\"><span class=\"ds-next-label\">UP NEXT</span><button type=\"button\">Add incident grouping rules</button><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M14 7l5 5-5 5\"/></svg></div></section>",
      "css": ".ds-milestone-panel{width:min(100%,650px);background:var(--white,#fff);border:1px solid var(--line,#e2e7e1);border-radius:var(--radius,12px);overflow:hidden;font-family:'Segoe UI',system-ui,-apple-system,sans-serif;color:var(--ink,#202e2b)}.ds-milestone-heading{margin:0;padding:21px 24px 0;font-size:16px;font-weight:650;line-height:1.3;letter-spacing:-.015em}.ds-milestones{padding:8px 24px 20px}.ds-milestone-row{display:grid;grid-template-columns:31px 1fr auto;column-gap:12px;padding:18px 0;position:relative}.ds-milestone-row:not(:last-child):before{content:\"\";position:absolute;width:1px;background:#dce5da;left:14px;top:43px;bottom:-12px}.ds-milestone-node{width:29px;height:29px;border-radius:50%;border:1px solid #ccd8cc;display:flex;align-items:center;justify-content:center;font-size:11px;position:relative;z-index:1}.ds-milestone-complete{background:#edf4ec;border-color:#d1e2d0;color:var(--green,#236b54)}.ds-milestone-current{background:var(--green,#236b54);color:var(--white,#fff);border-color:var(--green,#236b54)}.ds-milestone-node svg{width:14px;height:14px}.ds-milestone-info h3{font-size:13px;font-weight:600;line-height:1.5;margin:2px 0 4px}.ds-milestone-info p{font-size:11px;color:var(--muted,#62716b);line-height:1.65;margin:0}.ds-milestone-tail{text-align:right;padding-top:2px;font-size:11px;line-height:1.5;color:var(--muted,#62716b)}.ds-progress{width:68px;height:3px;margin-top:9px;background:#edf1e9;border-radius:6px;overflow:hidden}.ds-fill{height:100%;background:#3d8060;border-radius:6px;transition:width .2s ease}.ds-fill-complete{width:100%}.ds-fill-current{width:40%}.ds-next{border-top:1px solid var(--line,#e2e7e1);background:#fafcf8;padding:15px 24px;display:flex;gap:12px;align-items:center;font-size:12px}.ds-next-label{font-size:10px;color:var(--green,#236b54);font-weight:700;white-space:nowrap}.ds-next button{border:0;background:none;text-align:left;font-family:'Segoe UI',system-ui,-apple-system,sans-serif;font-size:12px;color:var(--ink,#202e2b);padding:0;flex:1;cursor:pointer}.ds-next button:hover{color:var(--green,#236b54)}.ds-next button:focus-visible{outline:3px solid var(--focus,#458a6c);outline-offset:3px;}.ds-next>svg{width:18px;height:18px;flex-shrink:0}@media(max-width:400px){.ds-milestones{padding:8px 20px 16px}.ds-milestone-row{grid-template-columns:29px 1fr auto;column-gap:9px}.ds-milestone-info h3{font-size:12px}.ds-milestone-info p,.ds-milestone-tail{font-size:10px}.ds-progress{width:48px}.ds-next{padding:14px 20px;gap:8px}.ds-next-label{font-size:9px}.ds-next button{font-size:11px}}@media(prefers-reduced-motion:reduce){.ds-fill{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "The Engineering Field Notebook",
    "overview": "Sidequest uses the calm organization of a field notebook: a paper ground, a dark forest navigation rail, precise headings, and connected milestone marks. Its personality comes from useful information arranged with care. Familiar controls keep project planning, technical rationale, and the next task easy to find.\n\nThis is a builder-selected direction, documented from the implemented interface rather than a claimed user aesthetic preference. The original field notebook choice is preserved through type, palette, density, and the milestone track. Technical handbooks, map keys, research notebooks, architecture journals, print specification sheets, and engineering drawing indices informed the original comparison; field notebooks were selected with seed `221ef68bca83539a`. No external visual challenger was available.",
    "keyCharacteristics": [
      "Quiet paper surfaces with a stable forest rail.",
      "Compact, legible controls and information-rich rows.",
      "Color tied to action, selection, status, or component kind.",
      "Connected milestones that make the next deliverable easy to scan.",
      "Native controls, authored stroke SVG, and visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "body": "Use accent color to convey action, selection, status, or implementation kind; keep the working canvas predominantly paper and white.",
        "section": "colors"
      },
      {
        "name": "The Small Type Rule",
        "body": "Preserve small labels for metadata; keep task titles, fields, and actionable text visually distinct from their supporting details.",
        "section": "typography"
      },
      {
        "name": "The Reflow Rule",
        "body": "Stack work sections and board lanes on small screens; reserve horizontal scrolling for comparisons whose columns are meaningful together.",
        "section": "layout"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Keep panels and task cards shadow-free; use elevation only when a temporary surface must sit above the workspace.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the paper ground, forest rail, and flat white work surfaces.",
      "**Do** use the existing semantic pairs for Software, GPT/API, and Mixed labels.",
      "**Do** retain the shared visible keyboard outline on every interactive control.",
      "**Do** keep native selects, checkboxes, and dialog behavior recognizable.",
      "**Do** stack work sections on mobile and wrap long technical content.",
      "**Do** keep milestone progress, due dates, and the next task easy to scan."
    ],
    "donts": [
      "**Don't** add ornamental shadows to resting panels or task cards.",
      "**Don't** use accent colors as decoration without a semantic role.",
      "**Don't** turn static category chips into implied actions.",
      "**Don't** replace useful labels with icon-only controls or color alone.",
      "**Don't** require external fonts or imagery to preserve the current identity.",
      "**Don't** add motion that survives the reduced-motion preference."
    ]
  }
}
